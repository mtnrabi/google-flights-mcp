# ── Upstream (RapidAPI) ──────────────────────────────────────────────────
# There is NO required secret in this file. Every search is billed to the
# caller's own RapidAPI subscription and their key arrives with the request,
# so this server boots and serves with none of the values below set.

RAPIDAPI_HOST=google-flights-live-api.p.rapidapi.com
# Defaults to https://<RAPIDAPI_HOST>. Only set this to point at a staging
# gateway or a first-party domain in front of RapidAPI.
RAPIDAPI_BASE_URL=
# Defaults to 75 = the deployed function's Timeout (60, read live 2026-08-27)
# plus a 15s margin covering the RapidAPI edge's relay of the verdict (measured
# at 60.21s and 60.23s on 2026-08-27). It must stay ABOVE 60: below it, the
# server abandons searches the backend was about to answer. There is no
# separate RapidAPI gateway ceiling near 45s -- earlier notes said so and the
# 2026-08-27 measurement retired the claim. Leave unset unless a deployment
# genuinely needs to differ.
REQUEST_TIMEOUT_SECONDS=

# DANGER: a server-side fallback key. When set, any caller who supplies no key
# is served on THIS subscription and billed to whoever owns it. Leave empty in
# production. /health reports whether it is set, precisely so it cannot be on
# by accident.
RAPIDAPI_KEY=

# ── Fan-out ──────────────────────────────────────────────────────────────
# Each date/destination combination is one request billed to the CALLER, so
# this cap exists to stop a model spending a user's quota on an over-broad
# question -- not to protect our own bill. Hard maximum is 60; callers can
# lower it per call with the `max_searches` tool argument.
MAX_SEARCHES_PER_TOOL_CALL=30
MAX_CONCURRENT_SEARCHES=10

# Ceiling on the shared outbound connection pool. Vercel functions share
# 1,024 file descriptors across ALL concurrent executions on an instance, and
# sockets come out of that pool.
MAX_HTTP_CONNECTIONS=60

# ── Product ──────────────────────────────────────────────────────────────
# Which product THIS deployment serves: flights, hotels, or both. One codebase,
# three deployments. It selects the tool set, the server instructions, the
# service name, the policy pages, and the RapidAPI listing a keyless or
# unsubscribed caller is sent to -- so a hotels deployment left on the default
# introduces itself as a flights server and sells the wrong subscription.
# A typo is rejected at boot rather than quietly serving both.
MCP_PRODUCTS=both

# Which product each HOSTNAME serves, when one deployment carries more than
# one. `google-flights-mcp` and `booking-hotels-mcp` are the same directory
# deployed twice; one project holding both domains halves that pair's cold
# starts, worth ~14% of the Vercel Hobby Active CPU cap. The product is chosen
# per request from the Host header so each listing keeps serving exactly its
# own tool set -- MCP_PRODUCTS=both would merge the tool sets instead, which
# is a product change, not a cost one.
#
#   default  the built-in map (the flightpowers.com aliases). The default.
#   off      no host routing. One product, from MCP_PRODUCTS. The rollback.
#   host=product,host=product   an explicit map, e.g. for a preview URL.
#
# A hostname not in the map falls back to MCP_PRODUCTS, so a single-product
# deployment is unaffected either way. Set MCP_PRODUCTS explicitly on any
# deployment that uses this: leaving it unset means the fallback is "both",
# which is a third tool set and a third FastMCP build on every cold start.
MCP_PRODUCTS_BY_HOST=default

# ── Serving ──────────────────────────────────────────────────────────────
# The exact public URL clients connect to, no trailing slash. Reported on
# /health and used in listings.
MCP_PUBLIC_URL=https://google-flights-mcp.flightpowers.com/mcp
# On a deployment serving several products, MCP_PUBLIC_URL_<PRODUCT> wins for
# that product -- otherwise the hotels hostname would advertise the flights
# hostname on /health and on every privacy/terms/support link it publishes.
# Same for SIGNUP_URL_<PRODUCT> below. Unsuffixed names still apply to
# whatever has no suffixed value, so a single-product deployment sets neither.
# MCP_PUBLIC_URL_FLIGHTS=https://google-flights-mcp.flightpowers.com/mcp
# MCP_PUBLIC_URL_HOTELS=https://hotels.flightpowers.com/mcp
HOST=0.0.0.0
PORT=8000
DEFAULT_RESULT_LIMIT=10

# Where users get a key. Quoted back to them verbatim whenever a call arrives
# without one, so it must be the page that actually has the Subscribe button.
# Defaults to the listing that matches MCP_PRODUCTS, so leave it unset unless
# this deployment really does point somewhere else. On MCP_PRODUCTS=both the
# hotel tools quote the Booking listing regardless, because one URL cannot be
# the Subscribe button for two APIs.
SIGNUP_URL=https://rapidapi.com/mtnrabi/api/google-flights-live-api
# SIGNUP_URL_FLIGHTS=https://rapidapi.com/mtnrabi/api/google-flights-live-api
# SIGNUP_URL_HOTELS=https://rapidapi.com/mtnrabi/api/booking-live-api

# Optional second log sink. Every tool call ALWAYS emits one JSON line to
# stdout prefixed "MCP_CALL " -- that is the record, and it is what Vercel
# captures. Set this only when running as a container with a writable path;
# leave it empty on Vercel, where the filesystem is read-only outside /tmp.
LOG_PATH=

# ── Shared counters (optional) ───────────────────────────────────────────
# Nothing here gates a request -- the caller pays their own bill, so there is
# no spend guard to arm. These counters exist only so a usage number can be
# published honestly. Without them, counts are per-instance and reset on every
# cold start, and /metrics says so rather than implying the zeros are real.
#   vercel install upstash     (injects these automatically)
# Stores migrated off the retired Vercel KV use KV_REST_API_URL/_TOKEN
# instead; both names are recognised.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional. When set, /metrics and /metrics/calls require the header
# x-metrics-token: <value>
METRICS_TOKEN=

# ── Directory submissions ────────────────────────────────────────────────
# OpenAI's plugin review verifies domain ownership by fetching
# /.well-known/openai-apps-challenge and requiring the body to be EXACTLY the
# token it issued -- no JSON, no newline. A human generates the token in the
# OpenAI portal; paste it here. Unset, the path 404s rather than serving an
# empty string that would look like a pass.
OPENAI_APPS_CHALLENGE_TOKEN=
